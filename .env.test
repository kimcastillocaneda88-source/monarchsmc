# Emulator-only configuration used by `npm run test:e2e`.
# These are not secrets: the Firebase emulators accept any project id and key.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=monarchs-mc-test.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=monarchs-mc-test
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=monarchs-mc-test.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3210

FIREBASE_PROJECT_ID=monarchs-mc-test
FIREBASE_STORAGE_BUCKET=monarchs-mc-test.appspot.com
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
