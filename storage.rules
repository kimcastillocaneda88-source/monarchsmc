rules_version = '2';

/**
 * MONARCHS MC — Firebase Storage Security Rules
 *
 * WRITES ARE DENIED TO EVERY CLIENT, everywhere. That is deliberate rather
 * than an oversight: all uploads go through the application, which
 * authenticates the caller, checks their permission for the target area,
 * applies a per-user rate limit, enforces a size ceiling, and identifies the
 * file by sniffing its actual leading bytes instead of trusting the declared
 * MIME type or extension. Allowing direct client writes would let every one of
 * those checks be skipped.
 *
 * Two upload paths exist, and neither is a client write in the Security Rules
 * sense:
 *   - POST /api/admin/upload sends the bytes through the server.
 *   - The media library issues a v4 signed URL from POST
 *     /api/media/upload-url. A signed URL carries the service account's own
 *     authority, so these rules never see it — which is why that route decides
 *     the object path, pins the content type, and why /api/media/complete reads
 *     the stored object back and deletes anything that is not what was
 *     authorised.
 *
 * Reads are split by area:
 *   gallery/ news/ rides/ events/  — deliberately public; these images appear
 *                                    on the public website.
 *   members/                       — private; served only through
 *                                    /api/media/member/[uid], which checks who
 *                                    is asking.
 *   documents/                     — private; served only through
 *                                    /api/documents/[id], which checks the
 *                                    member's role and records the download.
 *
 * Knowing a Storage path is therefore never sufficient to read a private file.
 */
service firebase.storage {
  match /b/{bucket}/o {

    /* Public imagery shown on the public site. */
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /news/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /rides/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /events/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    /* Member photographs. Private: the authorising route decides who sees them. */
    match /members/{uid}/{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }

    /* Club documents. Private under all circumstances. */
    match /documents/{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }

    /*
     * The member media library — photographs, video and files contributed by
     * approved accounts. Private: /api/media/file/[id] decides who may see an
     * item, and only ever hands out a short-lived signed read URL.
     */
    match /media/{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }

    /* Anything else is denied outright. */
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
